<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ThemeFoundationMD2" parent="Foundation.Default" />

    <!-- Kyubi: fixed dark brand theme for emulator-window use. -->
    <style name="ThemeFoundationMD2.Kyubi">
        <item name="colorPrimary">@color/kyubi_fox</item>
        <item name="colorPrimaryVariant">#80EF7F33</item>
        <item name="colorSecondary">@color/kyubi_amber</item>
        <item name="colorSecondaryVariant">#80F2913A</item>
        <item name="colorSurface">@color/kyubi_bg</item>
        <item name="colorSurfaceVariant">@color/kyubi_surface</item>
        <item name="colorSurfaceSurfaceVariant">@color/kyubi_surface_2</item>
        <item name="colorOnPrimary">@color/kyubi_bg</item>
        <item name="colorOnPrimaryVariant">@color/kyubi_fg</item>
        <item name="colorOnSecondary">@color/kyubi_bg</item>
        <item name="colorOnBackground">@color/kyubi_fg</item>
        <item name="colorError">@color/kyubi_ember</item>
        <item name="colorOnError">@color/kyubi_fg</item>
        <item name="colorOnSurface">@color/kyubi_fg</item>
        <item name="colorOnSurfaceVariant">@color/kyubi_muted</item>
        <item name="colorDisabled">@color/kyubi_dim</item>
        <item name="colorDisabledVariant">#666F6B7D</item>
        <item name="android:statusBarColor">@color/kyubi_bg</item>
        <item name="android:navigationBarColor">@color/kyubi_bg_2</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Pure-black option without changing Kyubi's typography or accents. -->
    <style name="ThemeFoundationMD2.KyubiAmoled" parent="ThemeFoundationMD2.Kyubi">
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceVariant">#121016</item>
        <item name="colorSurfaceSurfaceVariant">#1B1724</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

</resources>
