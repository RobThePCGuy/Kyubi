<?xml version="1.0" encoding="utf-8"?>
<!--
  Kyubi launcher icon - adaptive foreground (fox mask).
  Source of truth: assets/kyubi-mask.svg (Kyubi Rebrand Design Kit).
  The fox is scaled 0.68 around center so it clears a CIRCULAR launcher mask
  with room for launcher zoom - verified in preview/icon-proof.png.
  Do not enlarge past ~0.72 or the ear tips / chin risk clipping under a
  full-circle mask.  Background layer is @color/ic_launcher_background (#1B1730).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
  <group android:name="fox" android:pivotX="256" android:pivotY="256"
      android:scaleX="0.68" android:scaleY="0.68">

    <!-- ears: outer (bone) -->
    <path android:fillColor="#F4EEE2" android:pathData="M150,200 L212,178 L166,84 Z"/>
    <path android:fillColor="#F4EEE2" android:pathData="M362,200 L300,178 L346,84 Z"/>

    <!-- ears: inner (fox gradient) -->
    <path android:pathData="M170,178 L202,166 L176,108 Z">
      <aapt:attr name="android:fillColor">
        <gradient android:type="linear" android:startX="256" android:startY="84" android:endX="256" android:endY="412">
          <item android:offset="0" android:color="#F2913A"/>
          <item android:offset="1" android:color="#E8563A"/>
        </gradient>
      </aapt:attr>
    </path>
    <path android:pathData="M342,178 L310,166 L336,108 Z">
      <aapt:attr name="android:fillColor">
        <gradient android:type="linear" android:startX="256" android:startY="84" android:endX="256" android:endY="412">
          <item android:offset="0" android:color="#F2913A"/>
          <item android:offset="1" android:color="#E8563A"/>
        </gradient>
      </aapt:attr>
    </path>

    <!-- face (bone) -->
    <path android:fillColor="#F4EEE2" android:pathData="M256,172 C316,168 368,208 392,268 C372,320 320,372 256,412 C192,372 140,320 120,268 C144,208 196,168 256,172 Z"/>

    <!-- forehead flame -->
    <path android:pathData="M256,188 C240,208 240,232 256,258 C272,232 272,208 256,188 Z">
      <aapt:attr name="android:fillColor">
        <gradient android:type="linear" android:startX="256" android:startY="84" android:endX="256" android:endY="412">
          <item android:offset="0" android:color="#F2913A"/>
          <item android:offset="1" android:color="#E8563A"/>
        </gradient>
      </aapt:attr>
    </path>

    <!-- eyes (indigo, reads as cutout over the bone face) -->
    <path android:fillColor="#1B1730" android:pathData="M162,272 C186,260 214,268 226,288 C206,296 178,292 162,272 Z"/>
    <path android:fillColor="#1B1730" android:pathData="M350,272 C326,260 298,268 286,288 C306,296 334,292 350,272 Z"/>

    <!-- cheek marks -->
    <path android:pathData="M230,312 C194,336 160,330 130,300 C162,316 196,318 226,302 Z">
      <aapt:attr name="android:fillColor">
        <gradient android:type="linear" android:startX="256" android:startY="84" android:endX="256" android:endY="412">
          <item android:offset="0" android:color="#F2913A"/>
          <item android:offset="1" android:color="#E8563A"/>
        </gradient>
      </aapt:attr>
    </path>
    <path android:pathData="M282,312 C318,336 352,330 382,300 C350,316 316,318 286,302 Z">
      <aapt:attr name="android:fillColor">
        <gradient android:type="linear" android:startX="256" android:startY="84" android:endX="256" android:endY="412">
          <item android:offset="0" android:color="#F2913A"/>
          <item android:offset="1" android:color="#E8563A"/>
        </gradient>
      </aapt:attr>
    </path>

    <!-- nose -->
    <path android:pathData="M256,356 L240,332 L272,332 Z">
      <aapt:attr name="android:fillColor">
        <gradient android:type="linear" android:startX="256" android:startY="84" android:endX="256" android:endY="412">
          <item android:offset="0" android:color="#F2913A"/>
          <item android:offset="1" android:color="#E8563A"/>
        </gradient>
      </aapt:attr>
    </path>
  </group>
</vector>
